managed implementation in class zbp_cds_int_einv_const unique;
strict ( 2 );

define behavior for ZCDS_INT_EINV_CONST alias CONST
persistent table zteinv_const
lock master
authorization master ( instance, global )
{
  create;
  update;
  delete;

  field ( mandatory : create ) ProjectId, SystemId, Product, Country, CompanyCode, LabelCode, Sequence;
  field ( readonly : update ) ProjectId, SystemId, Product, Country, CompanyCode, LabelCode, Sequence;

  mapping for zteinv_const
    {
      ProjectId = projectid;
      SystemId = sysid;
      Product = product;
      Country = land1;
      CompanyCode = bukrs;
      LabelCode = zlabel;
      Sequence = sequence;
      LowValue = low;
      HighValue = high;
    }
}