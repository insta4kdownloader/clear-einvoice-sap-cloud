@EndUserText.label: 'Service Definitions for ELT Config Detai'
define service ZSD_ELT_CONFIG {
  expose ZCDS_CUN_COMP_DETAILS as COMPANY_DETAILS;
  expose ZCDS_CUN_ELT_CONFIG   as ELT_CONFIG_DETAILS;
  expose ZCDS_CUN_INS_CONFIG   as INS_CONFIG_DETAILS;
  expose ZCDS_CUN_COMP_CNTRY   as CNTRY_DETAILS;
  expose ZCDS_CUN_COMP_VAT     as VAT_DETAILS;
  expose ZCDS_CUN_COMP_API     as API_DETAILS;
  expose ZCDS_CUN_COMP_INVMAP  as INVMAP_DETAILS;
  expose ZCDS_CUN_COMP_DOCTYP  as DOCTYP_DETAILS;
}