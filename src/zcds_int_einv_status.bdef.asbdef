managed implementation in class zbp_cds_int_einv_status unique;
strict ( 2 );

define behavior for ZCDS_INT_EINV_STATUS alias STATUS
persistent table zteinv_status
lock master
authorization master ( instance, global )
{
  create;
  update;
  delete;

  field ( mandatory : create ) ProjectId, SystemId, Country, CompanyCode, Sequence, ProcessingMode;
  field ( readonly : update ) ProjectId, SystemId, Country, CompanyCode, Sequence, ProcessingMode;

  mapping for zteinv_status
    {
      ProjectId = projectid;
      SystemId = sysid;
      Country = land1;
      CompanyCode = bukrs;
      Sequence = sequence;
      ProcessingMode = proc_mode;
      Status = status;
      TargetStatus = status_to_be;
      StatusDescription = status_desc;
      Criticality = criticality;
    }
}