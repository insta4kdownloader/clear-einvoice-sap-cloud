/* API Endpoint as a tab. Managed child over zteinv_api, locked and authorized
   through the root - the same shape as ZCDS_CUN_ELT_CONFIG above.

   NOTE this is the SECOND managed BO over zteinv_api: the standalone
   e-Invoice API Endpoints app writes it through its own root BO. RAP permits
   it, and ZTELT_CONFIG has been in exactly this position since the
   ELT Config tab was built, but the two lock masters do not see each
   other - a row edited in both apps at once is last-writer-wins.
   Section 89. */
define behavior for ZCDS_CUN_COMP_API
persistent table zteinv_api
lock dependent by _COMPANY_DETAILS
authorization dependent by _COMPANY_DETAILS
{
  update;
  delete;

  field ( readonly : update ) ProjectId, SystemId, Country, CompanyCode, Functionality, Sequence;

  association _COMPANY_DETAILS;

  mapping for zteinv_api
    {
      ProjectId             = projectid;
      SystemId              = sysid;
      Country               = land1;
      CompanyCode           = bukrs;
      Functionality         = functionality;
      Sequence              = sequence;
      EndpointUrl           = url;
      ParameterName         = param_name;
      ParameterValue        = param_value;
    }
}

/* Relevance Mapping as a tab. Managed child over zteinv_invmap, locked and authorized
   through the root. Second managed BO over that table - see the note on
   the section 89 children; the standalone app writes it too.
   Section 90. */
define behavior for ZCDS_CUN_COMP_INVMAP
persistent table zteinv_invmap
lock dependent by _COMPANY_DETAILS
authorization dependent by _COMPANY_DETAILS
{
  update;
  delete;

  field ( readonly : update ) ProjectId, SystemId, Country, CompanyCode,
                              BillingDocumentType, AccountingDocumentType,
                              DocumentTypeCode;

  association _COMPANY_DETAILS;

  mapping for zteinv_invmap
    {
      ProjectId               = projectid;
      SystemId                = sysid;
      Country                 = land1;
      CompanyCode             = bukrs;
      BillingDocumentType     = fkart;
      AccountingDocumentType  = blart;
      DocumentTypeCode        = doc_type;
      IsEInvoiceRelevant      = einvoice;
      IsEWayBillRelevant      = ewaybill;
      IsNonIrn                = nonirn;
      HasNoAccountingDoc      = no_acc;
      IsB2C                   = b2c;
      IsPurchase              = purchase;
    }
}

