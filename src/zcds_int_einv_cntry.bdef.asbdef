managed implementation in class zbp_cds_int_einv_cntry unique;
strict ( 2 );

define behavior for ZCDS_INT_EINV_CNTRY alias CNTRY
persistent table zteinv_cntry
lock master
authorization master ( instance, global )
{
  create;
  update;
  delete;

  field ( mandatory : create ) ProjectId, SystemId, Country, CompanyCode, Sequence;
  field ( readonly : update ) ProjectId, SystemId, Country, CompanyCode, Sequence;

  mapping for zteinv_cntry
    {
      ProjectId = projectid;
      SystemId = sysid;
      Country = land1;
      CompanyCode = bukrs;
      Sequence = sequence;
      VatRegistrationNumber = vat;
      CountryDescription = land1_desc;
      AutoGenerate = auto_einv_generate;
      AutoCancel = auto_einv_cancel;
      HandlerClass = handler_class;
    }
}