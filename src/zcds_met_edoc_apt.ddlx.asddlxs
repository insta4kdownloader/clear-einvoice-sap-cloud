  @UI: { lineItem:       [ { position: 20, label: 'VAT category code', importance: #HIGH }],
         identification: [ { position: 70, label: 'VAT category code' } ] }
  TaxCategory;

  @UI: { lineItem:       [ { position: 30, label: 'VAT rate', importance: #HIGH }],
         identification: [ { position: 80, label: 'VAT rate' } ] }
  TaxPercent;

  @UI: { identification: [ { position: 90, label: 'Tax scheme ID' } ] }
  TaxScheme;

  @UI: { identification: [ { position: 100, label: 'VAT exemption reason code' } ] }
